<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <link rel="stylesheet" href="/home.css">
    <link rel="stylesheet" href="/planupdate.css">
  </head>
  <body>
    <main class="page-shell">
      <header class="app-header">
        <div>
          <p class="route-label">/plans/<%= plan.id %>/update</p>
          <h1>旅行プランを編集する</h1>
        </div>
        <a class="ghost-button" href="/plans/<%= plan.id %>">詳細へ戻る</a>
      </header>

      <form id="planEditForm" class="editor-panel" action="/plans/<%= plan.id %>/update" method="post">
        <section class="form-section">
          <h2>基本情報</h2>
          <div class="form-grid">
            <label>
              <span>タイトル</span>
              <input type="text" name="name" value="<%= plan.name %>" required>
            </label>
            <label>
              <span>ステータス</span>
              <select name="status">
                <option value="計画中" <%= plan.status === "計画中" ? "selected" : "" %>>計画中</option>
                <option value="完了" <%= plan.status === "完了" ? "selected" : "" %>>完了</option>
              </select>
            </label>
            <label>
              <span>開始日</span>
              <input type="date" name="started_at" value="<%= formatDateTime(plan.startedAt).slice(0, 10) %>">
            </label>
            <label>
              <span>終了日</span>
              <input type="date" name="ended_at" value="<%= formatDateTime(plan.endedAt).slice(0, 10) %>">
            </label>
          </div>
        </section>

        <section class="form-section">
          <div class="section-heading">
            <h2>行程・スポット</h2>
            <button class="secondary-button" type="button" data-add-schedule>＋ スポットを追加</button>
          </div>
          <div class="schedule-list" data-schedule-list>
            <% schedules.forEach((schedule, index) => { %>
              <div class="schedule-shell">
                <%- include("schedule-fields", { mode: "existing", index: index + 1, schedule, formatDateTime }) %>
                <div class="schedule-actions">
                  <button class="ghost-button" type="submit" form="move-up-<%= schedule.id %>">↑</button>
                  <button class="ghost-button" type="submit" form="move-down-<%= schedule.id %>">↓</button>
                  <button class="danger-button" type="submit" form="delete-schedule-<%= schedule.id %>">削除</button>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

        <div class="sticky-actions">
          <button class="primary-button" type="submit">更新</button>
          <a class="ghost-button" href="/plans/<%= plan.id %>">キャンセル</a>
        </div>
      </form>

      <% schedules.forEach((schedule) => { %>
        <form id="move-up-<%= schedule.id %>" action="/plans/<%= plan.id %>/schedules/<%= schedule.id %>/move" method="post">
          <input type="hidden" name="direction" value="up">
        </form>
        <form id="move-down-<%= schedule.id %>" action="/plans/<%= plan.id %>/schedules/<%= schedule.id %>/move" method="post">
          <input type="hidden" name="direction" value="down">
        </form>
        <form id="delete-schedule-<%= schedule.id %>" action="/plans/<%= plan.id %>/schedules/<%= schedule.id %>/delete" method="post" onsubmit="return confirm('このスポットを削除しますか？')"></form>
      <% }) %>

      <template id="scheduleTemplate">
        <%- include("schedule-fields", { mode: "new", index: "__INDEX__", schedule: null, formatDateTime }) %>
      </template>
    </main>
    <script src="/planform.js"></script>
  </body>
</html>
