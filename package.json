{
  "name": "travel-plan-app",
  "version": "1.0.0",
  "description": "EJS and Express travel planning app backed by SQLite and Sequelize.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.18.3",
    "method-override": "^3.0.0",
    "sequelize": "^6.37.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/method-override": "^0.0.35",
    "@types/node": "^20.11.24",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
